      "id": "f265e121-bd9f-495d-803e-405a449ec156",
      "name": "Get All Missions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -580,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
