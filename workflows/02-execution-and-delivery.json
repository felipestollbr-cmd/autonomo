      "id": "e0ac67a1-598d-4116-85ab-7e76aee38efe",
      "name": "Get All Missions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -580,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
