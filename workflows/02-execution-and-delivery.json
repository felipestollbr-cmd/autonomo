      "id": "ed6b5f25-de69-48f3-b36b-f15ffb489449",
      "name": "Get All Missions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -580,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
