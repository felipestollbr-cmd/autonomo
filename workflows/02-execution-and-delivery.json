          "name": "Anthropic x-api-key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nlet text = \"\";\nif (Array.isArray(r.content)) {\n  text = r.content.filter(b => b.type === \"text\").map(b => b.text).join(\"\\n\").trim();\n}\nif (!text) text = \"(sem retorno da IA)\";\nconst chatId = $('Prepare Exec').item.json.chatId;\nreturn [{ json: { chatId, telegramText: \"🛠️ *Rascunho de entrega* (revise antes de enviar):\\n\\n\" + text } }];\n"
      },
      "id": "480e57dc-de41-470c-a26b-b9b370d47eb8",
