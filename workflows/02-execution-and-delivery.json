        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"status\": \"delivered\", \"deliveryText\": $json.deliveryText } }}",
        "options": {}
      },
      "id": "6cf336cd-6a6a-478b-bcef-5764c286b5ac",
