      "id": "e7128c97-d09f-470d-be8f-a7498ead7f7a",
      "name": "Get All Missions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -580,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
