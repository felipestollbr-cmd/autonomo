      "id": "55163b46-7fea-4e59-9fb5-0e5065a36bc4",
      "name": "Gemini — Draft Bid",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        600
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "WpY7l5UFa42YJTdG",
          "name": "Header Auth account"
